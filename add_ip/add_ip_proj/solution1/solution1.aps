<AutoPilot:solution xmlns:AutoPilot="com.autoesl.autopilot.solution">
    <config>
        <config_compile complex-mul-dsp="0" name_max_length="256"/>
        <config_rtl reset="control"/>
        <config_export description="Element-wise Add" display_name="FastVIT_Add_IP" format="ip_catalog" vendor="user.org" version="1.0"/>
    </config>
    <name>
        <value string="solution1"/>
    </name>
    <project>
        <value string="add_ip_proj"/>
    </project>
    <flowTarget value="vivado"/>
    <targetInfo>
        <TargetInfo value="xc7z020:-clg400:-1"/>
    </targetInfo>
    <libraryList>
        <library value="xilinx/zynq/zynq" name="DefaultPlatform"/>
    </libraryList>
    <clockList>
        <clock name="default" period="7" default="false"/>
    </clockList>
</AutoPilot:solution>

