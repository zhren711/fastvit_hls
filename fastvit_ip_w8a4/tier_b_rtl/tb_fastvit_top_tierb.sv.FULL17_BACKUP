// ==================================================================
// AXI4-Lite bus-functional master tasks
// ==================================================================
task automatic axi_ctrl_write(input [6:0] addr, input [31:0] data);
    reg aw_done, w_done;
    begin
        @(posedge ap_clk);
        s_axi_ctrl_AWADDR  <= addr;  s_axi_ctrl_AWVALID <= 1'b1;
        s_axi_ctrl_WDATA   <= data;  s_axi_ctrl_WSTRB   <= 4'hF; s_axi_ctrl_WVALID <= 1'b1;
        s_axi_ctrl_BREADY  <= 1'b1;
        aw_done = 1'b0; w_done = 1'b0;
        while (!(aw_done && w_done)) begin
            @(posedge ap_clk);
            if (!aw_done && s_axi_ctrl_AWVALID && s_axi_ctrl_AWREADY) begin s_axi_ctrl_AWVALID <= 1'b0; aw_done = 1'b1; end
            if (!w_done  && s_axi_ctrl_WVALID  && s_axi_ctrl_WREADY)  begin s_axi_ctrl_WVALID  <= 1'b0; w_done  = 1'b1; end
        end
        while (!s_axi_ctrl_BVALID) @(posedge ap_clk);
        s_axi_ctrl_BREADY <= 1'b0;
        @(posedge ap_clk);
    end
endtask

task automatic axi_ctrl_read(input [6:0] addr, output [31:0] data);
    begin
        @(posedge ap_clk);
        s_axi_ctrl_ARADDR <= addr; s_axi_ctrl_ARVALID <= 1'b1;
        s_axi_ctrl_RREADY <= 1'b1;
        while (!(s_axi_ctrl_ARVALID && s_axi_ctrl_ARREADY)) @(posedge ap_clk);
        s_axi_ctrl_ARVALID <= 1'b0;
        while (!s_axi_ctrl_RVALID) @(posedge ap_clk);
        data = s_axi_ctrl_RDATA;
        s_axi_ctrl_RREADY <= 1'b0;
        @(posedge ap_clk);
    end
endtask

task automatic axi_control_write(input [5:0] addr, input [31:0] data);
    reg aw_done, w_done;
    begin
        @(posedge ap_clk);
        s_axi_control_AWADDR  <= addr;  s_axi_control_AWVALID <= 1'b1;
        s_axi_control_WDATA   <= data;  s_axi_control_WSTRB   <= 4'hF; s_axi_control_WVALID <= 1'b1;
        s_axi_control_BREADY  <= 1'b1;
        aw_done = 1'b0; w_done = 1'b0;
        while (!(aw_done && w_done)) begin
            @(posedge ap_clk);
            if (!aw_done && s_axi_control_AWVALID && s_axi_control_AWREADY) begin s_axi_control_AWVALID <= 1'b0; aw_done = 1'b1; end
            if (!w_done  && s_axi_control_WVALID  && s_axi_control_WREADY)  begin s_axi_control_WVALID  <= 1'b0; w_done  = 1'b1; end
        end
        while (!s_axi_control_BVALID) @(posedge ap_clk);
        s_axi_control_BREADY <= 1'b0;
        @(posedge ap_clk);
    end
endtask

task automatic set_ptr64(input [5:0] lo_addr, input [63:0] value);
    begin
        axi_control_write(lo_addr,       value[31:0]);
        axi_control_write(lo_addr + 6'h4, value[63:32]);
    end
endtask

task automatic wait_ap_done;
    reg [31:0] st;
    begin
        st = 32'd0;
        while (!st[1]) axi_ctrl_read(7'h00, st);
        repeat (50) @(posedge ap_clk); // let any in-flight AXI writes drain through the adapter before checking memory
    end
endtask

// ==================================================================
// Memory preload / readback helpers
// ==================================================================
// Some workers (confirmed: pwconv_worker) read a FIXED tile-sized burst
// from DRAM (e.g. PW_TS=64 activations = 8 packed words) regardless of
// the actual (smaller) test dimensions -- normal, expected behavior
// (the worker's own internal logic only consumes the valid subset), but
// it means reads legitimately go past a small test's exact data
// footprint. Zero a generous padding region first so those over-reads
// see defined 0s instead of X (there's 4KB of headroom between each
// test region's base addresses already).
task automatic zero_region(input [63:0] base, input int nbytes);
    int i;
    begin
        for (i = 0; i < nbytes; i = i + 1) tb_mem[base + i] = 8'h00;
    end
endtask

task automatic load_words32(input string fname, input [63:0] base, input int count);
    reg [31:0] tmp [0:511];
    int i;
    begin
        $readmemh(fname, tmp, 0, count-1);
        for (i = 0; i < count; i = i + 1) begin
            tb_mem[base+i*4+0] = tmp[i][7:0];
            tb_mem[base+i*4+1] = tmp[i][15:8];
            tb_mem[base+i*4+2] = tmp[i][23:16];
            tb_mem[base+i*4+3] = tmp[i][31:24];
        end
    end
endtask

task automatic load_bytes8(input string fname, input [63:0] base, input int count);
    reg [7:0] tmp [0:511];
    int i;
    begin
        $readmemh(fname, tmp, 0, count-1);
        for (i = 0; i < count; i = i + 1) tb_mem[base+i] = tmp[i];
    end
endtask

integer g_errors = 0;

task automatic check_words32(input string name, input [63:0] base, input string golden_file, input int count);
    reg [31:0] exp [0:511];
    reg [31:0] got;
    int i, errs;
    begin
        $readmemh(golden_file, exp, 0, count-1);
        errs = 0;
        for (i = 0; i < count; i = i + 1) begin
            got = {tb_mem[base+i*4+3], tb_mem[base+i*4+2], tb_mem[base+i*4+1], tb_mem[base+i*4+0]};
            if (got !== exp[i]) begin
                errs = errs + 1;
                if (errs <= 5) $display("  MISMATCH[%0d]: hw=%08x exp=%08x", i, got, exp[i]);
            end
        end
        if (errs == 0) $display("[PASS] %s (%0d words)", name, count);
        else           $display("[FAIL] %s (%0d/%0d word mismatches)", name, errs, count);
        g_errors = g_errors + errs;
    end
endtask

