    axi_ctrl_write(7'h28, 32'd4);  // Win
    axi_ctrl_write(7'h38, 32'd0);  // act_mode NONE
    axi_ctrl_write(7'h40, 32'd2);  // out_shift
    axi_ctrl_write(7'h48, 32'd1);  // stride_h
    axi_ctrl_write(7'h50, 32'd1);  // stride_w
    axi_ctrl_write(7'h58, 32'd1);  // pad_h
    axi_ctrl_write(7'h60, 32'd1);  // pad_w
    axi_ctrl_write(7'h68, 32'd3);  // Kh
    axi_ctrl_write(7'h70, 32'd3);  // Kw
    axi_ctrl_write(7'h78, 32'd1);  // fpg
    axi_ctrl_write(7'h00, 32'h1);
    wait_ap_done();
    check_words32("OP_DWCONV", 64'h0001_4000, {GOLDEN_DIR,"dwconv_out.hex"}, 4);

    // ---------------- OP_PWCONV ----------------
    // Matches the existing regression's "PW_small" dims (CHin=16,H=4,W=4,
    // CHout=32): CHin/CHout must each be >= PW_TM/PW_TN(8), confirmed via
    // this testbench -- a smaller CHin=4/CHout=4 case made pwconv_worker's
    // tile-loop-count (integer division) evaluate to 0 tiles and skip the
    // write phase entirely (all-X output, zero gmem3 writes observed).
    zero_region(64'h0002_1000, 2048);
    zero_region(64'h0002_2000, 2048);
    zero_region(64'h0002_3000, 2048);
    load_words32({GOLDEN_DIR,"pwconv_in.hex"},   64'h0002_1000, 32);
    load_bytes8 ({GOLDEN_DIR,"pwconv_wt.hex"},   64'h0002_2000, 512);
    load_words32({GOLDEN_DIR,"pwconv_bias.hex"}, 64'h0002_3000, 32);
    set_ptr64(6'h10, 64'h0002_1000);
    set_ptr64(6'h1c, 64'h0002_2000);
    set_ptr64(6'h28, 64'h0002_3000);
    set_ptr64(6'h34, 64'h0002_4000);
    axi_ctrl_write(7'h10, OP_PWCONV);
    axi_ctrl_write(7'h18, 32'd16); // CHin
    axi_ctrl_write(7'h20, 32'd4);  // H
    axi_ctrl_write(7'h28, 32'd4);  // W
    axi_ctrl_write(7'h30, 32'd32); // CHout
    axi_ctrl_write(7'h38, 32'd1);  // act_mode RELU
    axi_ctrl_write(7'h40, 32'd6);  // out_shift
    axi_ctrl_write(7'h00, 32'h1);
    wait_ap_done();
    check_words32("OP_PWCONV", 64'h0002_4000, {GOLDEN_DIR,"pwconv_out.hex"}, 64);

    // ---------------- OP_ADD ----------------
    load_words32({GOLDEN_DIR,"add_in1.hex"}, 64'h0003_1000, 2);
    load_bytes8 ({GOLDEN_DIR,"add_in2.hex"}, 64'h0003_2000, 16);
    set_ptr64(6'h10, 64'h0003_1000);
    set_ptr64(6'h1c, 64'h0003_2000);
    set_ptr64(6'h34, 64'h0003_4000);
    axi_ctrl_write(7'h10, OP_ADD);
    axi_ctrl_write(7'h18, 32'd1);  // CHin
    axi_ctrl_write(7'h20, 32'd4);  // Hin
    axi_ctrl_write(7'h28, 32'd4);  // Win
    axi_ctrl_write(7'h00, 32'h1);
    wait_ap_done();
    check_words32("OP_ADD", 64'h0003_4000, {GOLDEN_DIR,"add_out.hex"}, 2);

    // ---------------- OP_GELU ----------------
    load_words32({GOLDEN_DIR,"gelu_in.hex"}, 64'h0004_1000, 1);
    set_ptr64(6'h10, 64'h0004_1000);
    set_ptr64(6'h34, 64'h0004_4000);
    axi_ctrl_write(7'h10, OP_GELU);
    axi_ctrl_write(7'h18, 32'd8);  // CHin
    axi_ctrl_write(7'h20, 32'd1);  // Hin
    axi_ctrl_write(7'h28, 32'd1);  // Win
    axi_ctrl_write(7'h00, 32'h1);
    wait_ap_done();
    check_words32("OP_GELU", 64'h0004_4000, {GOLDEN_DIR,"gelu_out.hex"}, 1);

    // ---------------- back-to-back sequence: ADD then GELU on ADD's own output ----------------
    // (re-run ADD into a fresh output region, then GELU consumes THAT region as
    //  its own input, mimicking the driver's write-op/ap_start/wait-done/write-next-op protocol)
    set_ptr64(6'h10, 64'h0003_1000);
    set_ptr64(6'h1c, 64'h0003_2000);
    set_ptr64(6'h34, 64'h0005_1000);
    axi_ctrl_write(7'h10, OP_ADD);
    axi_ctrl_write(7'h18, 32'd1);
    axi_ctrl_write(7'h20, 32'd4);
    axi_ctrl_write(7'h28, 32'd4);
    axi_ctrl_write(7'h00, 32'h1);
    wait_ap_done();
    check_words32("Sequence step1 (ADD)", 64'h0005_1000, {GOLDEN_DIR,"add_out.hex"}, 2);

    set_ptr64(6'h10, 64'h0005_1000);
    set_ptr64(6'h34, 64'h0005_4000);
    axi_ctrl_write(7'h10, OP_GELU);
    axi_ctrl_write(7'h18, 32'd1);
    axi_ctrl_write(7'h20, 32'd4);
    axi_ctrl_write(7'h28, 32'd4);
    axi_ctrl_write(7'h00, 32'h1);
    wait_ap_done();
    // reference: apply gelu_lut to add_out.hex directly (same values,
    // different op) -- compute expected on the fly isn't available here,
    // so this step reports PASS/FAIL only vs a manually precomputed file
    // if present; otherwise just confirms the sequence completes.
    $display("[INFO] Sequence step2 (GELU-after-ADD) completed (ap_done seen); no independent golden file for this composite step, dispatch-sequencing is what's under test here.");

    $display("=====================================");
    if (g_errors == 0) $display("ALL TESTS PASSED");
    else $display("TOTAL ERRORS: %0d", g_errors);
    $finish;
end

endmodule
